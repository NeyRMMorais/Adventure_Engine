# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_PIN: Simple PIN gate for the web UI and adventure APIs.
APP_PIN="17081986"

# GOOGLE_CLIENT_ID: Client ID for Google OAuth login.
# GOOGLE_CLIENT_SECRET: Client secret for Google OAuth login.
# Obtained from Google Cloud Console (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AUTH_SECRET: Used to sign the HttpOnly authentication cookie.
# Set this to a long random value in production.
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Usage limits: Protect against unexpected Gemini usage and costs.
# Set a value to 0 to disable that specific limit.
DAILY_STORY_LIMIT="100"
DAILY_IMAGE_LIMIT="30"
SESSION_STORY_LIMIT="20"
SESSION_IMAGE_LIMIT="10"
DAILY_ESTIMATED_USD_LIMIT="0"

# Optional cost estimate inputs.
# Pricing changes over time, so keep these updated from current Gemini pricing if you use estimated USD totals.
COST_TEXT_INPUT_USD_PER_1M_TOKENS="0"
COST_TEXT_OUTPUT_USD_PER_1M_TOKENS="0"
COST_IMAGE_USD_PER_GENERATED_IMAGE="0"
